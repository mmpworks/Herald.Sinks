<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Pulsar</RootNamespace>
    <AssemblyName>Herald.Sinks.Pulsar</AssemblyName>
    <PackageId>Herald.Sinks.Pulsar</PackageId>
    <Version>1.0.0</Version>
    <Description>Sends Herald log events to an Apache Pulsar topic via DotPulsar. Multi-tenant pub/sub for streaming + queue patterns.</Description>
    <PackageTags>herald;logging;sink;pulsar;streaming</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotPulsar" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Pulsar.Tests" />
  </ItemGroup>
</Project>
