<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Exceptionless</RootNamespace>
    <AssemblyName>Herald.Sinks.Exceptionless</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Exceptionless</PackageId>
    <Version>1.0.0</Version>
    <Description>Forwards Herald log events to the Exceptionless error-tracking platform. Drop-in for Serilog.Sinks.Exceptionless.</Description>
    <PackageTags>herald;logging;sink;exceptionless;error-tracking</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Exceptionless.Tests" />
  </ItemGroup>
</Project>
