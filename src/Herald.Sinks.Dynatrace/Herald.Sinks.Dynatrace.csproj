<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Dynatrace</RootNamespace>
    <AssemblyName>Herald.Sinks.Dynatrace</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Dynatrace</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events to Dynatrace Generic Log Ingest API. Drop-in for Serilog.Sinks.Dynatrace. No SDK dependency — pure HTTP with API-Token authentication.</Description>
    <PackageTags>herald;logging;sink;dynatrace;observability</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Dynatrace.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
