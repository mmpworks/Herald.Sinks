<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.TextWriter</RootNamespace>
    <AssemblyName>Herald.Sinks.TextWriter</AssemblyName>
    <PackageId>MMP.Herald.Sinks.TextWriter</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events to an arbitrary System.IO.TextWriter — tests, memory streams, custom writers, anything the caller supplies.</Description>
    <PackageTags>herald;logging;sink;textwriter;io</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.TextWriter.Tests" />
  </ItemGroup>
</Project>
