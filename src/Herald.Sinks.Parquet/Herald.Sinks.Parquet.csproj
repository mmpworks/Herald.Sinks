<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Parquet</RootNamespace>
    <AssemblyName>Herald.Sinks.Parquet</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Parquet</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events as Apache Parquet files. Columnar long-term storage suitable for analytical queries (Spark, DuckDB, Athena, Trino). Optional Iceberg catalog hook (no-op by default).</Description>
    <PackageTags>herald;logging;sink;parquet;analytics;iceberg</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Parquet.Net" />
    <!-- Parquet.Net 5.0.2 pulls Snappier 1.1.6 transitively; explicit
         reference pulls the safe central pin to the top of the graph
         (NU1903 fix for GHSA-pggp-6c3x-2xmx). -->
    <PackageReference Include="Snappier" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
    <!-- configuration*.mmpform pack rule now lives universally in
         Modules/Herald.Sinks/Directory.Build.props; keeping it here
         would cause an NU5118 duplicate-file error during pack. -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Parquet.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
