<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Syslog</RootNamespace>
    <AssemblyName>Herald.Sinks.Syslog</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Syslog</PackageId>
    <Version>1.0.0</Version>
    <Description>Emits Herald log events as RFC 3164 or RFC 5424 syslog messages over UDP or TCP — drop-in for Serilog.Sinks.SyslogMessages.</Description>
    <PackageTags>herald;logging;sink;syslog;rfc3164;rfc5424</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Syslog.Tests" />
  </ItemGroup>
</Project>
