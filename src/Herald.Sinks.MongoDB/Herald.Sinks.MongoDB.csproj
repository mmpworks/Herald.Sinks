<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.MongoDB</RootNamespace>
    <AssemblyName>Herald.Sinks.MongoDB</AssemblyName>
    <PackageId>Herald.Sinks.MongoDB</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events as BSON documents into a MongoDB collection. Drop-in for Serilog.Sinks.MongoDB. Single insert on Log, bulk insert on IBatchedLogSink.</Description>
    <PackageTags>herald;logging;sink;mongodb;nosql</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <!-- MongoDB.Driver 3.0.0 pulls Snappier 1.0.0 + SharpCompress 0.30.1
         transitively; explicit references pull the safe central pins to
         the top of the graph (NU1903 GHSA-pggp-6c3x-2xmx, NU1902
         GHSA-6c8g-7p36-r338). -->
    <PackageReference Include="Snappier" />
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.MongoDB.Tests" />
  </ItemGroup>
</Project>
