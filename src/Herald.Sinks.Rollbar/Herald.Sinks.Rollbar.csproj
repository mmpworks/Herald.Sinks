<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Rollbar</RootNamespace>
    <AssemblyName>Herald.Sinks.Rollbar</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Rollbar</PackageId>
    <Version>1.0.0</Version>
    <Description>Reports Herald log events to Rollbar via the public Items API. HTTP-only — no SDK dependency.</Description>
    <PackageTags>herald;logging;sink;rollbar;errors</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Rollbar.Tests" />
  </ItemGroup>
</Project>
