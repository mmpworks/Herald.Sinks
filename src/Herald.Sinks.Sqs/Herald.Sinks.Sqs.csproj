<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Sqs</RootNamespace>
    <AssemblyName>Herald.Sinks.Sqs</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Sqs</PackageId>
    <Version>1.0.0</Version>
    <Description>SendMessage Herald log events into an AWS SQS queue via AWSSDK.SQS. Drop-in for Serilog.Sinks.AmazonSqs.</Description>
    <PackageTags>herald;logging;sink;aws;sqs;queue</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Sqs.Tests" />
  </ItemGroup>
</Project>
