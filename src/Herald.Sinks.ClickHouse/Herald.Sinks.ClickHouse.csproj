<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.ClickHouse</RootNamespace>
    <AssemblyName>Herald.Sinks.ClickHouse</AssemblyName>
    <PackageId>MMP.Herald.Sinks.ClickHouse</PackageId>
    <Version>1.0.0</Version>
    <Description>Inserts Herald log events into a ClickHouse table via the ClickHouse.Client driver. Drop-in for Serilog ClickHouse integrations.</Description>
    <PackageTags>herald;logging;sink;clickhouse;analytics;columnar</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClickHouse.Client" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.ClickHouse.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
