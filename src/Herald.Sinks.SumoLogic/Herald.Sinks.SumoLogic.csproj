<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.SumoLogic</RootNamespace>
    <AssemblyName>Herald.Sinks.SumoLogic</AssemblyName>
    <PackageId>MMP.Herald.Sinks.SumoLogic</PackageId>
    <Version>1.0.0</Version>
    <Description>Posts Herald log events to a Sumo Logic HTTP source endpoint. Drop-in for SumoLogic.Logging.Serilog.</Description>
    <PackageTags>herald;logging;sink;sumologic;observability</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.SumoLogic.Tests" />
  </ItemGroup>
</Project>
