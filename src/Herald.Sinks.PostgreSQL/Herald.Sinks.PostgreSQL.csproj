<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.PostgreSQL</RootNamespace>
    <AssemblyName>Herald.Sinks.PostgreSQL</AssemblyName>
    <PackageId>Herald.Sinks.PostgreSQL</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events as rows in a PostgreSQL table. Drop-in for Serilog.Sinks.PostgreSQL. Parameterized INSERT on single writes, COPY binary protocol on batches, optional auto-create.</Description>
    <PackageTags>herald;logging;sink;postgresql;postgres;npgsql</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.PostgreSQL.Tests" />
  </ItemGroup>
</Project>
