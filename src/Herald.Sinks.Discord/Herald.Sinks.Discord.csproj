<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Discord</RootNamespace>
    <AssemblyName>Herald.Sinks.Discord</AssemblyName>
    <PackageId>Herald.Sinks.Discord</PackageId>
    <Version>1.0.0</Version>
    <Description>Posts Herald log events to a Discord channel via incoming webhooks. HTTP-only.</Description>
    <PackageTags>herald;logging;sink;discord;chat</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Discord.Tests" />
  </ItemGroup>
</Project>
