<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.InfluxDB</RootNamespace>
    <AssemblyName>Herald.Sinks.InfluxDB</AssemblyName>
    <PackageId>MMP.Herald.Sinks.InfluxDB</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events to InfluxDB v2 via line protocol over HTTP. No InfluxDB SDK dependency.</Description>
    <PackageTags>herald;logging;sink;influxdb;timeseries</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.InfluxDB.Tests" />
  </ItemGroup>
</Project>
