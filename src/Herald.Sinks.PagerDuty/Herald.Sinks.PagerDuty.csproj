<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.PagerDuty</RootNamespace>
    <AssemblyName>Herald.Sinks.PagerDuty</AssemblyName>
    <PackageId>MMP.Herald.Sinks.PagerDuty</PackageId>
    <Version>1.0.0</Version>
    <Description>Posts Herald log events to PagerDuty's Events API v2 for incident creation. Stable dedup-key derivation collapses repeats into one open alert; stack behind a Warn-or-above filter.</Description>
    <PackageTags>herald;logging;sink;pagerduty;alerting</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.PagerDuty.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
