<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.RavenDB</RootNamespace>
    <AssemblyName>Herald.Sinks.RavenDB</AssemblyName>
    <PackageId>MMP.Herald.Sinks.RavenDB</PackageId>
    <Version>1.0.0</Version>
    <Description>Stores Herald log events as documents in a RavenDB database via the RavenDB.Client SDK. Drop-in for Serilog.Sinks.RavenDB.</Description>
    <PackageTags>herald;logging;sink;ravendb;document;nosql</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RavenDB.Client" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.RavenDB.Tests" />
  </ItemGroup>
</Project>
