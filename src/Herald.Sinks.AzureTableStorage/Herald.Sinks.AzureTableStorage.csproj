<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.AzureTableStorage</RootNamespace>
    <AssemblyName>Herald.Sinks.AzureTableStorage</AssemblyName>
    <PackageId>MMP.Herald.Sinks.AzureTableStorage</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events as entities into an Azure Table Storage table via Azure.Data.Tables. Drop-in for Serilog.Sinks.AzureTableStorage.</Description>
    <PackageTags>herald;logging;sink;azure;table-storage;nosql</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.AzureTableStorage.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
