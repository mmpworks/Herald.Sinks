<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.MicrosoftTeams</RootNamespace>
    <AssemblyName>Herald.Sinks.MicrosoftTeams</AssemblyName>
    <PackageId>MMP.Herald.Sinks.MicrosoftTeams</PackageId>
    <Version>1.0.0</Version>
    <Description>Posts Herald log events to a Microsoft Teams channel via an incoming webhook. Drop-in for Serilog.Sinks.MicrosoftTeams.Alternative. Adaptive Card format.</Description>
    <PackageTags>herald;logging;sink;microsoft-teams;webhook;alerting</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.MicrosoftTeams.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
