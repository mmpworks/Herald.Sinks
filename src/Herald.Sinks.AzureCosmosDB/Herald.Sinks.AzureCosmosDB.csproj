<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.AzureCosmosDB</RootNamespace>
    <AssemblyName>Herald.Sinks.AzureCosmosDB</AssemblyName>
    <PackageId>MMP.Herald.Sinks.AzureCosmosDB</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events as documents in an Azure Cosmos DB container via the modern v3 SDK. Drop-in for Serilog.Sinks.AzureCosmosDB.</Description>
    <PackageTags>herald;logging;sink;azure;cosmosdb;nosql</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>

    <!-- Cosmos SDK 3.x checks for a Newtonsoft.Json reference at build
         time. We don't use Newtonsoft — the sink serialises via
         Utf8JsonWriter — so disable the check. The SDK falls back to
         its own internal serializer when the check is bypassed. -->
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Cosmos" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.AzureCosmosDB.Tests" />
  </ItemGroup>
</Project>
