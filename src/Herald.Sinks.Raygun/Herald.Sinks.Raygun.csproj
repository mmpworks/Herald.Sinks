<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Raygun</RootNamespace>
    <AssemblyName>Herald.Sinks.Raygun</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Raygun</PackageId>
    <Version>1.0.0</Version>
    <Description>Forwards Herald log events to the Raygun crash-reporting / error-tracking service. Drop-in for Serilog.Sinks.Raygun.</Description>
    <PackageTags>herald;logging;sink;raygun;crash-reporting</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Raygun.Tests" />
  </ItemGroup>
</Project>
