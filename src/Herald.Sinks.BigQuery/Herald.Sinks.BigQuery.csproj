<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.BigQuery</RootNamespace>
    <AssemblyName>Herald.Sinks.BigQuery</AssemblyName>
    <PackageId>MMP.Herald.Sinks.BigQuery</PackageId>
    <Version>1.0.0</Version>
    <Description>Streaming-inserts Herald log events into a Google BigQuery table via Google.Cloud.BigQuery.V2.</Description>
    <PackageTags>herald;logging;sink;bigquery;gcp;analytics</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Cloud.BigQuery.V2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.BigQuery.Tests" />
  </ItemGroup>
</Project>
