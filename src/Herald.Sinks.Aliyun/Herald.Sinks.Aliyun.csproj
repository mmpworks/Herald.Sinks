<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Aliyun</RootNamespace>
    <AssemblyName>Herald.Sinks.Aliyun</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Aliyun</PackageId>
    <Version>1.0.0</Version>
    <Description>Sends Herald log events to Alibaba Cloud Simple Log Service (SLS). Drop-in for the Aliyun Serilog sink ecosystem. HMAC-SHA1-signed HTTP PUT to the SLS REST API.</Description>
    <PackageTags>herald;logging;sink;aliyun;alibaba-cloud;sls;china</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Aliyun.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
