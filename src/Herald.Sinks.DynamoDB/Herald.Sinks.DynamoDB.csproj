<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.DynamoDB</RootNamespace>
    <AssemblyName>Herald.Sinks.DynamoDB</AssemblyName>
    <PackageId>MMP.Herald.Sinks.DynamoDB</PackageId>
    <Version>1.0.0</Version>
    <Description>PutItems Herald log events into a DynamoDB table via AWSSDK.DynamoDBv2. Drop-in for Serilog.Sinks.AmazonDynamoDB.</Description>
    <PackageTags>herald;logging;sink;aws;dynamodb;nosql</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.DynamoDB.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
