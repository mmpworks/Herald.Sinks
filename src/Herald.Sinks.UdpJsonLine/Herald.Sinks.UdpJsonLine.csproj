<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.UdpJsonLine</RootNamespace>
    <AssemblyName>Herald.Sinks.UdpJsonLine</AssemblyName>
    <PackageId>MMP.Herald.Sinks.UdpJsonLine</PackageId>
    <Version>1.0.0</Version>
    <Description>Fires Herald log events as newline-delimited JSON datagrams over UDP. One datagram per event, no acknowledgement — suited to syslog-style ingest and lossy-tolerant pipelines.</Description>
    <PackageTags>herald;logging;sink;udp;json;syslog</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.UdpJsonLine.Tests" />
  </ItemGroup>
</Project>
