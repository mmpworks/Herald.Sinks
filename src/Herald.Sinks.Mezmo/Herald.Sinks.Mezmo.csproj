<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Mezmo</RootNamespace>
    <AssemblyName>Herald.Sinks.Mezmo</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Mezmo</PackageId>
    <Version>1.0.0</Version>
    <Description>Ships Herald log events to Mezmo (formerly LogDNA) via the public ingest endpoint. HTTP-only.</Description>
    <PackageTags>herald;logging;sink;mezmo;logdna;observability</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Mezmo.Tests" />
  </ItemGroup>
</Project>
