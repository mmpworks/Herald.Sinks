<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.MSSqlServer</RootNamespace>
    <AssemblyName>Herald.Sinks.MSSqlServer</AssemblyName>
    <PackageId>Herald.Sinks.MSSqlServer</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events as rows in a Microsoft SQL Server or Azure SQL table. Drop-in for Serilog.Sinks.MSSqlServer. Parameterized INSERT on single writes, SqlBulkCopy on batches, optional auto-create.</Description>
    <PackageTags>herald;logging;sink;sql-server;mssql;azure-sql</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.MSSqlServer.Tests" />
  </ItemGroup>
</Project>
