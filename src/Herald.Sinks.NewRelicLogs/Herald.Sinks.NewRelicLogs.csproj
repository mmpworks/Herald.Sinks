<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.NewRelicLogs</RootNamespace>
    <AssemblyName>Herald.Sinks.NewRelicLogs</AssemblyName>
    <PackageId>Herald.Sinks.NewRelicLogs</PackageId>
    <Version>1.0.0</Version>
    <Description>Ships Herald log events to the New Relic Logs ingest API. Drop-in for Serilog.Sinks.NewRelic.Logs.</Description>
    <PackageTags>herald;logging;sink;newrelic;observability</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.NewRelicLogs.Tests" />
  </ItemGroup>
</Project>
