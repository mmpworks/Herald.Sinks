<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Seq</RootNamespace>
    <AssemblyName>Herald.Sinks.Seq</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Seq</PackageId>
    <Version>1.0.0</Version>
    <Description>Posts Herald log events to a Seq server as newline-delimited CLEF over HTTP. Matches the wire format Serilog.Sinks.Seq uses so existing Seq deployments keep working.</Description>
    <PackageTags>herald;logging;sink;seq;clef;structured</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Seq.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
