<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.LogzIo</RootNamespace>
    <AssemblyName>Herald.Sinks.LogzIo</AssemblyName>
    <PackageId>Herald.Sinks.LogzIo</PackageId>
    <Version>1.0.0</Version>
    <Description>Ships Herald log events to Logz.io via the bulk HTTP listener. Drop-in for Serilog.Sinks.Logz.Io. NDJSON body, token in URL.</Description>
    <PackageTags>herald;logging;sink;logzio;observability</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.LogzIo.Tests" />
  </ItemGroup>
</Project>
