<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Bugsnag</RootNamespace>
    <AssemblyName>Herald.Sinks.Bugsnag</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Bugsnag</PackageId>
    <Version>1.0.0</Version>
    <Description>Reports Herald log events to Bugsnag via the public notify API. Drop-in for Serilog.Sinks.Bugsnag. HTTP-only — no SDK dependency.</Description>
    <PackageTags>herald;logging;sink;bugsnag;errors;crash-reporting</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Bugsnag.Tests" />
  </ItemGroup>
</Project>
