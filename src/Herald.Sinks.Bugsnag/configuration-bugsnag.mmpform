# Bugsnag sink — public notify API.
# Flat form: every field on its own row, no collapsible sections.

columns: 12

__properties = [
    "api_key"       = { type: "string", default: "" },
    "endpoint"      = { type: "string", default: "https://notify.bugsnag.com/" },
    "release_stage" = { type: "string", default: "production" }
]

tooltips = [
    "tt-api-key"  = "Bugsnag project API key — masked after save.",
    "tt-endpoint" = "Notify endpoint — leave default unless using an on-prem Bugsnag.",
    "tt-release"  = "Release stage tag (production, staging, development, ...) — drives Bugsnag's dashboard filtering."
]

[container("Bugsnag sink", "Reports Herald log events to Bugsnag via the public notify API.")]

  - [secret(12,{api_key},tt="tt-api-key",required=true)] API key
  - [url(12,{endpoint},tt="tt-endpoint",init="https://notify.bugsnag.com/")] Notify endpoint
  - [textfield(12,{release_stage},tt="tt-release",init="production")] Release stage
