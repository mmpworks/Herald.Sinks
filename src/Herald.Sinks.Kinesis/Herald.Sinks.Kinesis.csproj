<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Kinesis</RootNamespace>
    <AssemblyName>Herald.Sinks.Kinesis</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Kinesis</PackageId>
    <Version>1.0.0</Version>
    <Description>PutRecords Herald log events into an AWS Kinesis Data Stream via AWSSDK.Kinesis. Drop-in for Serilog.Sinks.AmazonKinesis.</Description>
    <PackageTags>herald;logging;sink;aws;kinesis;streaming</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.Kinesis" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Kinesis.Tests" />
  </ItemGroup>
</Project>
