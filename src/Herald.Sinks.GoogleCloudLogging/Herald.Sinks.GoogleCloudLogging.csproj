<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.GoogleCloudLogging</RootNamespace>
    <AssemblyName>Herald.Sinks.GoogleCloudLogging</AssemblyName>
    <PackageId>Herald.Sinks.GoogleCloudLogging</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events to Google Cloud Logging via LoggingServiceV2Client.WriteLogEntries. Drop-in for Serilog.Sinks.GoogleCloudLogging.</Description>
    <PackageTags>herald;logging;sink;gcp;google-cloud;stackdriver</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Google.Cloud.Logging.V2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.GoogleCloudLogging.Tests" />
  </ItemGroup>
</Project>
