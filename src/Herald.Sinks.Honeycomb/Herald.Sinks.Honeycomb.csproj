<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Honeycomb</RootNamespace>
    <AssemblyName>Herald.Sinks.Honeycomb</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Honeycomb</PackageId>
    <Version>1.0.0</Version>
    <Description>Posts Herald log events to Honeycomb's batch ingest endpoint. Maps events onto Honeycomb's flat data-object shape with per-event sample-rate support.</Description>
    <PackageTags>herald;logging;sink;honeycomb;observability</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Honeycomb.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
