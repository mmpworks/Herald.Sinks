<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.ApplicationInsightsHttp</RootNamespace>
    <AssemblyName>Herald.Sinks.ApplicationInsightsHttp</AssemblyName>
    <PackageId>MMP.Herald.Sinks.ApplicationInsightsHttp</PackageId>
    <Version>1.0.0</Version>
    <Description>POSTs Herald log events as MessageData telemetry envelopes directly to Azure Application Insights' ingestion endpoint. No Microsoft.ApplicationInsights SDK dependency — just HttpClient. Pair with Herald.Sinks.ApplicationInsightsSdk if you want idiomatic AI telemetry types (TraceTelemetry, ExceptionTelemetry).</Description>
    <PackageTags>herald;logging;sink;azure;application-insights;apm;http;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.ApplicationInsightsHttp.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
