<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.AzureAnalytics</RootNamespace>
    <AssemblyName>Herald.Sinks.AzureAnalytics</AssemblyName>
    <PackageId>MMP.Herald.Sinks.AzureAnalytics</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events to Azure Log Analytics / Azure Monitor via the Data Collector API. Drop-in for Serilog.Sinks.AzureAnalytics. HTTP-only — no Azure SDK dependency.</Description>
    <PackageTags>herald;logging;sink;azure;log-analytics;azure-monitor</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.AzureAnalytics.Tests" />
  </ItemGroup>
</Project>
