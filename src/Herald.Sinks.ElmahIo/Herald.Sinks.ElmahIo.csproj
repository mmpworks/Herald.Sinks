<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.ElmahIo</RootNamespace>
    <AssemblyName>Herald.Sinks.ElmahIo</AssemblyName>
    <PackageId>MMP.Herald.Sinks.ElmahIo</PackageId>
    <Version>1.0.0</Version>
    <Description>Ships Herald log events to elmah.io error tracking. Drop-in for Serilog.Sinks.ElmahIo.</Description>
    <PackageTags>herald;logging;sink;elmahio;error-tracking</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.ElmahIo.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
