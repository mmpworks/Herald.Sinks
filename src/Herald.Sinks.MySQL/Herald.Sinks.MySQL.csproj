<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.MySQL</RootNamespace>
    <AssemblyName>Herald.Sinks.MySQL</AssemblyName>
    <PackageId>MMP.Herald.Sinks.MySQL</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events as rows in a MySQL / MariaDB table via MySqlConnector. Drop-in for Serilog.Sinks.MySQL. Parameterized INSERT with batched transactions.</Description>
    <PackageTags>herald;logging;sink;mysql;mariadb</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.MySQL.Tests" />
  </ItemGroup>
</Project>
