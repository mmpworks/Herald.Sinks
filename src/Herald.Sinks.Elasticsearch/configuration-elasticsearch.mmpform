# Elasticsearch sink — Bulk API ingest.
# Flat form: every field on its own row, no collapsible sections.

columns: 12

__properties = [
    "base_url"      = { type: "string", default: "" },
    "index_prefix"  = { type: "string", default: "herald-logs" },
    "username"      = { type: "string", default: "" },
    "password"      = { type: "string", default: "" },
    "api_key"       = { type: "string", default: "" },
    "schema"        = { type: "string", default: "native" },
    "ecs_version"   = { type: "string", default: "8.11.0" },
    "event_dataset" = { type: "string", default: "app" }
]

tooltips = [
    "tt-url"     = "Elasticsearch base URL — http or https.",
    "tt-prefix"  = "Index prefix — daily indices land at {prefix}-yyyy.MM.dd.",
    "tt-user"    = "Username for HTTP Basic auth — leave blank for unauthenticated clusters.",
    "tt-pass"    = "Password for HTTP Basic auth — masked after save.",
    "tt-key"     = "API key for the Authorization: ApiKey header — alternative to username/password.",
    "tt-schema"  = "Document shape — 'native' (default, Herald-native) or 'ecs' (strict Elastic Common Schema). Set 'ecs' only when your cluster runs an ECS index template, on a new index alias.",
    "tt-ecsver"  = "ECS version emitted in ecs.version (ECS mode only). Match your cluster's ECS template version.",
    "tt-dataset" = "event.dataset value (ECS mode only) — drives index routing and ILM policy."
]

[container("Elasticsearch sink", "Sends Herald log events to Elasticsearch as JSON documents via the Bulk API. Supports HTTP Basic auth or API-key auth.")]

  - [url(12,{base_url},tt="tt-url",required=true,placeholder="https://elasticsearch.example.com:9200")] Base URL
  - [textfield(12,{index_prefix},tt="tt-prefix",init="herald-logs")] Index prefix
  - [textfield(12,{username},tt="tt-user")] Username
  - [secret(12,{password},tt="tt-pass")] Password
  - [secret(12,{api_key},tt="tt-key")] API key
  - [textfield(12,{schema},tt="tt-schema",init="native")] Schema (native | ecs)
  - [textfield(12,{ecs_version},tt="tt-ecsver",init="8.11.0")] ECS version
  - [textfield(12,{event_dataset},tt="tt-dataset",init="app")] Event dataset
