<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.RedisList</RootNamespace>
    <AssemblyName>Herald.Sinks.RedisList</AssemblyName>
    <PackageId>MMP.Herald.Sinks.RedisList</PackageId>
    <Version>1.0.0</Version>
    <Description>RPUSHes Herald log events as JSON entries onto a Redis list via StackExchange.Redis. Drop-in for Serilog.Sinks.Redis.List. Optional LTRIM cap for bounded retention.</Description>
    <PackageTags>herald;logging;sink;redis;list;nosql</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.RedisList.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
