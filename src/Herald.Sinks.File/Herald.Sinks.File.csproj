<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.File</RootNamespace>
    <AssemblyName>Herald.Sinks.File</AssemblyName>
    <PackageId>Herald.Sinks.File</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events to disk. Plain-text or structured (NDJSON) format with optional time-based or size-based rolling.</Description>
    <PackageTags>herald;logging;sink;file;ndjson;rolling</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Rolling-file behaviour lives in MMP.RollingFiles (Apache 2.0,
       framework-neutral, AOT-clean). Now a normal NuGet dependency:
       consumers of Herald.Sinks.File get MMP.RollingFiles.dll flowing
       into their bin\ as a transitive package, same as any other
       declared dependency. -->
  <ItemGroup>
    <PackageReference Include="MMP.RollingFiles" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
    <!-- mmpform side-file packing now lives in
         Modules/Herald.Sinks/Directory.Build.props so every sink's
         nupkg ships the form schema at its root, not just File. -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.File.Tests" />
  </ItemGroup>
</Project>
