<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.File</RootNamespace>
    <AssemblyName>Herald.Sinks.File</AssemblyName>
    <PackageId>Herald.Sinks.File</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events to disk. Plain-text or structured (NDJSON) format with optional time-based or size-based rolling.</Description>
    <PackageTags>herald;logging;sink;file;ndjson;rolling</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
<!-- Rolling-file behaviour now lives in MMP.RollingFiles. The
         project reference is intentional during phase 1 of the
         migration; once the standalone repo publishes a NuGet, this
         line flips to a <PackageReference> with the same key.

         PrivateAssets="all" prevents the in-tree ProjectReference
         from leaking into the produced .nupkg as an unresolvable
         transitive dependency. Consumers of MMP.Herald.Sinks.File
         must not see a project-path reference to a sibling repo
         that does not exist on their disk. The dependency becomes
         a normal <PackageReference> once the standalone library
         publishes; until then, the assets stay private. -->
    <ProjectReference Include="..\..\..\MMP.RollingFiles\packages\dotnet\MMP.RollingFiles\MMP.RollingFiles.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
    <!-- mmpform side-file packing now lives in
         Modules/Herald.Sinks/Directory.Build.props so every sink's
         nupkg ships the form schema at its root, not just File. -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.File.Tests" />
  </ItemGroup>
</Project>
