<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.OpenSearch</RootNamespace>
    <AssemblyName>Herald.Sinks.OpenSearch</AssemblyName>
    <PackageId>MMP.Herald.Sinks.OpenSearch</PackageId>
    <Version>1.0.0</Version>
    <Description>Indexes Herald log events into an OpenSearch cluster via the _bulk API. Drop-in for Serilog.Sinks.OpenSearch. Pure HTTP — no OpenSearch SDK dependency.</Description>
    <PackageTags>herald;logging;sink;opensearch;aws</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.OpenSearch.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
