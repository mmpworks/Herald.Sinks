<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.SQLite</RootNamespace>
    <AssemblyName>Herald.Sinks.SQLite</AssemblyName>
    <PackageId>Herald.Sinks.SQLite</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events to an embedded SQLite database. Drop-in for Serilog.Sinks.SQLite. Single-file, no server, no deps beyond Microsoft.Data.Sqlite.</Description>
    <PackageTags>herald;logging;sink;sqlite;embedded</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.SQLite.Tests" />
  </ItemGroup>
</Project>
