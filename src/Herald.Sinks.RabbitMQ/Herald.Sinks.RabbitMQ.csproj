<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.RabbitMQ</RootNamespace>
    <AssemblyName>Herald.Sinks.RabbitMQ</AssemblyName>
    <PackageId>MMP.Herald.Sinks.RabbitMQ</PackageId>
    <Version>1.0.0</Version>
    <Description>Publishes Herald log events to a RabbitMQ exchange with a routing key. Drop-in for Serilog.Sinks.RabbitMQ — persistent channel, single publish per event, JSON body.</Description>
    <PackageTags>herald;logging;sink;rabbitmq;amqp;queue</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.RabbitMQ.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
