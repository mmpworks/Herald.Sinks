<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Splunk</RootNamespace>
    <AssemblyName>Herald.Sinks.Splunk</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Splunk</PackageId>
    <Version>1.0.0</Version>
    <Description>Posts Herald log events to Splunk's HTTP Event Collector (HEC). Matches the wire shape Serilog.Sinks.Splunk uses.</Description>
    <PackageTags>herald;logging;sink;splunk;hec</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Splunk.Tests" />
  </ItemGroup>
</Project>
