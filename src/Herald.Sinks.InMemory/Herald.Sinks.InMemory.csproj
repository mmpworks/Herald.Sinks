<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.InMemory</RootNamespace>
    <AssemblyName>Herald.Sinks.InMemory</AssemblyName>
    <PackageId>MMP.Herald.Sinks.InMemory</PackageId>
    <Version>1.0.0</Version>
    <Description>Retains Herald log events in-memory for assertion-based testing. The sink exposes a snapshot list and a Clear() call for per-test isolation.</Description>
    <PackageTags>herald;logging;sink;testing;in-memory</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.InMemory.Tests" />
  </ItemGroup>
</Project>
