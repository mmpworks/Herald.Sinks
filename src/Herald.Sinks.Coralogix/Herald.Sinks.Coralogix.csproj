<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Coralogix</RootNamespace>
    <AssemblyName>Herald.Sinks.Coralogix</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Coralogix</PackageId>
    <Version>1.0.0</Version>
    <Description>Ships Herald log events to Coralogix via the bulk-logs ingest endpoint. HTTP-only.</Description>
    <PackageTags>herald;logging;sink;coralogix;observability</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Coralogix.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
