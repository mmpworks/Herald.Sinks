<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.ApplicationInsightsSdk</RootNamespace>
    <AssemblyName>Herald.Sinks.ApplicationInsightsSdk</AssemblyName>
    <PackageId>Herald.Sinks.ApplicationInsightsSdk</PackageId>
    <Version>1.0.0</Version>
    <Description>Tracks Herald log events as TelemetryClient.TrackTrace / TrackException calls into Azure Application Insights via the Microsoft.ApplicationInsights SDK. Drop-in for Serilog.Sinks.ApplicationInsights. Pair with Herald.Sinks.ApplicationInsightsHttp if you want the same destination without the SDK dependency.</Description>
    <PackageTags>herald;logging;sink;azure;application-insights;apm;sdk</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.ApplicationInsightsSdk.Tests" />
  </ItemGroup>
</Project>
