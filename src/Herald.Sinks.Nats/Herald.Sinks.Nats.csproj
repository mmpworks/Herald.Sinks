<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Nats</RootNamespace>
    <AssemblyName>Herald.Sinks.Nats</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Nats</PackageId>
    <Version>1.0.0</Version>
    <Description>Publishes Herald log events to a NATS subject via NATS.Client.Core. Cloud-native messaging with JetStream-ready delivery.</Description>
    <PackageTags>herald;logging;sink;nats;messaging</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NATS.Client.Core" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Nats.Tests" />
  </ItemGroup>
</Project>
