<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Mqtt</RootNamespace>
    <AssemblyName>Herald.Sinks.Mqtt</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Mqtt</PackageId>
    <Version>1.0.0</Version>
    <Description>Publishes Herald log events to an MQTT broker via MQTTnet. IoT pub/sub for HiveMQ / Mosquitto / EMQX.</Description>
    <PackageTags>herald;logging;sink;mqtt;iot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MQTTnet" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Mqtt.Tests" />
  </ItemGroup>
</Project>
