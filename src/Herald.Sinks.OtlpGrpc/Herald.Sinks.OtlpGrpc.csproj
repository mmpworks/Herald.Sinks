<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.OtlpGrpc</RootNamespace>
    <AssemblyName>Herald.Sinks.OtlpGrpc</AssemblyName>
    <PackageId>MMP.Herald.Sinks.OtlpGrpc</PackageId>
    <Version>1.0.0</Version>
    <Description>Herald sink for OTLP/gRPC log export. Sends ExportLogsServiceRequest payloads to an OpenTelemetry collector over HTTP/2 + gRPC. Reuses the hand-rolled OtlpProtobufLogSerializer from Herald.Sinks.Otlp so the package stays AOT-clean — no proto codegen, no generated message types.</Description>
    <PackageTags>herald;logging;sink;otlp;grpc;opentelemetry</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
    <!-- Reuse OtlpProtobufLogSerializer (and OtlpDefaults / severity
         mapper) from the HTTP-OTLP sink. Sharing the serializer keeps
         payload shape identical across HTTP and gRPC transports and
         avoids duplicating the hand-rolled protobuf writer. -->
    <ProjectReference Include="..\Herald.Sinks.Otlp\Herald.Sinks.Otlp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
    <None Include="configuration*.mmpform" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.OtlpGrpc.Tests" />
  </ItemGroup>
</Project>
