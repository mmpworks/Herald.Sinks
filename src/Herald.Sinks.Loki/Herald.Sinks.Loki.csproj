<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Loki</RootNamespace>
    <AssemblyName>Herald.Sinks.Loki</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Loki</PackageId>
    <Version>1.0.0</Version>
    <Description>Posts Herald log events to Grafana Loki's push endpoint. Batches events by label set for minimum-stream delivery and keeps high-cardinality properties out of the label index.</Description>
    <PackageTags>herald;logging;sink;loki;grafana</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>


  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Loki.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
