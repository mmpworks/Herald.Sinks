<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.AzureLogAnalyticsDcr</RootNamespace>
    <AssemblyName>Herald.Sinks.AzureLogAnalyticsDcr</AssemblyName>
    <PackageId>MMP.Herald.Sinks.AzureLogAnalyticsDcr</PackageId>
    <Version>1.0.0</Version>
    <Description>Writes Herald log events to Azure Monitor via the modern DCR-based Log Ingestion API. Successor to Herald.Sinks.AzureAnalytics (legacy Data Collector).</Description>
    <PackageTags>herald;logging;sink;azure;log-analytics;azure-monitor;dcr</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Monitor.Ingestion" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.AzureLogAnalyticsDcr.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
