<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.AzureServiceBus</RootNamespace>
    <AssemblyName>Herald.Sinks.AzureServiceBus</AssemblyName>
    <PackageId>MMP.Herald.Sinks.AzureServiceBus</PackageId>
    <Version>1.0.0</Version>
    <Description>SendMessage Herald log events into an Azure Service Bus queue or topic via Azure.Messaging.ServiceBus.</Description>
    <PackageTags>herald;logging;sink;azure;service-bus;queue</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.AzureServiceBus.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
