<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Graylog</RootNamespace>
    <AssemblyName>Herald.Sinks.Graylog</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Graylog</PackageId>
    <Version>1.0.0</Version>
    <Description>Sends Herald log events to Graylog as GELF messages over HTTP or TCP. Drop-in for Serilog.Sinks.Graylog / Graylog.Batching.</Description>
    <PackageTags>herald;logging;sink;graylog;gelf</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Graylog.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
