<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.AmazonS3</RootNamespace>
    <AssemblyName>Herald.Sinks.AmazonS3</AssemblyName>
    <PackageId>Herald.Sinks.AmazonS3</PackageId>
    <Version>1.0.0</Version>
    <Description>Uploads Herald log events as NDJSON objects to an Amazon S3 bucket. Drop-in for Serilog.Sinks.AmazonS3. Periodic batch upload via IBatchedLogSink.</Description>
    <PackageTags>herald;logging;sink;aws;s3</PackageTags>
    <IsAotCompatible>false</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.AmazonS3.Tests" />
  </ItemGroup>
</Project>
