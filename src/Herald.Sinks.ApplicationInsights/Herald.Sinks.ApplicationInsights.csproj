<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.ApplicationInsights</RootNamespace>
    <AssemblyName>Herald.Sinks.ApplicationInsights</AssemblyName>
    <PackageId>MMP.Herald.Sinks.ApplicationInsights</PackageId>
    <Version>1.0.0</Version>
    <Description>Tracks Herald log events as TelemetryClient.TrackTrace / TrackException calls into Azure Application Insights. Drop-in for Serilog.Sinks.ApplicationInsights.</Description>
    <PackageTags>herald;logging;sink;azure;application-insights;apm</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.ApplicationInsights.Tests" />
  </ItemGroup>
</Project>
