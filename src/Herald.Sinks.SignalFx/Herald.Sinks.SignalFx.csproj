<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.SignalFx</RootNamespace>
    <AssemblyName>Herald.Sinks.SignalFx</AssemblyName>
    <PackageId>MMP.Herald.Sinks.SignalFx</PackageId>
    <Version>1.0.0</Version>
    <Description>Posts Herald log events to SignalFx / Splunk Observability Cloud's HTTP log intake. Supports realm-based routing and self-hosted endpoint overrides.</Description>
    <PackageTags>herald;logging;sink;signalfx;splunk;observability</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Herald.Core lives as a sibling submodule under Modules/Core. The
         sink depends on Core's contracts (ILogSinkProvider, LogEvent,
         ILogger) and nothing else. -->
</ItemGroup>

  <ItemGroup>
    <!-- CAPABILITY.yaml is the Dashboard + product-sheet contract. Pack
         it into the NuGet so consumers and the release pipeline read
         the same source of truth. -->
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.SignalFx.Tests" />
  </ItemGroup>

  <!-- Batching decorator: the provider wraps its sink with
       BatchingLogSinkDecorator.Wrap so the producer never blocks on
       delivery. Shared utility package, referenced like Herald.OSS. -->
  <ItemGroup>
    <ProjectReference Include="../Herald.Sinks.Batching/Herald.Sinks.Batching.csproj" />
  </ItemGroup>
</Project>
