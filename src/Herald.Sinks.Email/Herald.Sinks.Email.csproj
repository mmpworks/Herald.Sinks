<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Email</RootNamespace>
    <AssemblyName>Herald.Sinks.Email</AssemblyName>
    <PackageId>MMP.Herald.Sinks.Email</PackageId>
    <Version>1.0.0</Version>
    <Description>Sends Herald log events as SMTP email via MailKit. Drop-in for Serilog.Sinks.Email. Sized for high-severity alerts.</Description>
    <PackageTags>herald;logging;sink;email;smtp;alerting</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**;build\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Herald.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="CAPABILITY.yaml" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.Sinks.Email.Tests" />
  </ItemGroup>
</Project>
