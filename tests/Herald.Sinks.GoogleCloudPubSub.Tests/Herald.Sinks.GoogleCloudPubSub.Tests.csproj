      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Herald.Sinks.GoogleCloudPubSub\Herald.Sinks.GoogleCloudPubSub.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Core\tests\Helpers\*.cs" LinkBase="_CoreTestHelpers" />
  </ItemGroup>
