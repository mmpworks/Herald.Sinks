<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.Couchbase.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>HERALD004;xUnit1031</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- CouchbaseNetClient's unsafe transitive Snappier 1.2.0 reaches this
         test project via the ProjectReference below. Restate the explicit
         pin (central version 1.3.1) to clear NU1903 here too. -->
    <PackageReference Include="Snappier" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Herald.Sinks.Couchbase\Herald.Sinks.Couchbase.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\_shared\*.cs" LinkBase="_CoreTestHelpers" />
  </ItemGroup>
</Project>
