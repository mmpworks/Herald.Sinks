<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.Sinks.File.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>HERALD004;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Herald.Sinks.File\Herald.Sinks.File.csproj" />
    <!-- The sink-under-test pins MMP.RollingFiles with
         PrivateAssets="all" so the produced .nupkg does not leak a
         project-path reference to a sibling repo. The test project
         still needs the types directly to write FilesManagerPolicy
         and CompressionMode assertions, so the same ProjectReference
         lands here without the private-assets gate. -->
    <ProjectReference Include="..\..\..\MMP.RollingFiles\packages\dotnet\MMP.RollingFiles\MMP.RollingFiles.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the small test-helper set from Core's test project via
         linked-compile rather than a test-project-to-test-project
         reference. Same pattern Herald.Sinks.SignalFx.Tests uses. -->
    <Compile Include="..\_shared\*.cs" LinkBase="_CoreTestHelpers" />
  </ItemGroup>
</Project>
