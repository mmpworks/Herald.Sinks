<Project>
  <!--
    Repo-wide defaults for every sink csproj in Herald.Sinks. Overrides
    per-sink lives in the individual csproj.
  -->
  <PropertyGroup>
    <Authors>Steven Muchow</Authors>
    <Company>MMPWorks LLC</Company>
    <Copyright>Copyright (c) 2026 MMPWorks LLC</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mmpworks/Herald.Sinks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mmpworks/Herald.Sinks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      Version of Herald.OSS that every sink in this repo depends on.
      Pinned here so a single edit moves the whole sink ecosystem to
      a new Herald.OSS release. Standalone clones of Herald.Sinks
      (where Herald.OSS isn't a sibling directory) restore Herald.OSS
      from nuget.org at this version; the umbrella-monorepo build uses
      a live ProjectReference to ../../../Herald.OSS/ instead and
      ignores the pin. Herald.OSS is the canonical upstream — the
      former Modules/Core route is retired.
    -->
    <HeraldCoreVersion>0.2.1</HeraldCoreVersion>
  </PropertyGroup>

  <!--
    Pack-on-build, opt-in. Off by default so a developer's local
    `dotnet build` stays fast; CI flips HeraldPackOnBuild on for
    release runs:

      dotnet build -c Release -p:HeraldPackOnBuild=true

    This pairs with the .github/workflows/sinks-release.yml workflow,
    which also passes -p:Version=$TAG to override the per-csproj
    <Version>1.0.0</Version> declarations with the tag the release
    was cut from. CI uses `dotnet pack` explicitly rather than relying
    on GeneratePackageOnBuild — both produce the same .nupkg, but the
    explicit step is easier to gate, observe, and re-run if a single
    push fails partway through. Leaving the property here gives
    local-dev convenience (build = pack in one command) without
    coupling to the CI shape.
  -->
  <PropertyGroup Condition="'$(HeraldPackOnBuild)' == 'true' AND '$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Pack the LICENSE file into every produced NuGet so consumers
       receive the terms alongside the code. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

  <!-- Ship a README.md at the .nupkg root and register it as the
       package's readme so nuget.org renders it on the package page.
       README content is generated from CAPABILITY.yaml by
       tools/generate-readmes.cjs; re-run after manifest edits. The
       PackageReadmeFile property only fires when a README.md actually
       exists in the project root so sinks without one (e.g. test-only
       Herald.Sinks.HelloWorld) don't fail pack with NU5039. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\README.md')">
    <None Include="README.md"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

  <!-- Embed CAPABILITY.yaml into every sink assembly when one exists at
       the project root. The Dashboard server reads it back at runtime
       via Assembly.GetManifestResourceStream so the UI can build a
       per-sink configuration form without a side-channel manifest file.
       Per-sink csprojs continue to ship the YAML in the .nupkg root via
       their own None+Pack item; the two paths do not conflict. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\CAPABILITY.yaml')">
    <EmbeddedResource Include="CAPABILITY.yaml">
      <LogicalName>CAPABILITY.yaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Embed every configuration*.mmpform file present in the project
       root. v2 sink-config forms authored in the FormBuilderDSL
       grammar. Two layouts are supported and ILogSinkProvider's
       default GetFormSchemaText() picks whichever is shipped:
         - configuration.mmpform              one form for the sink
         - configuration-{SinkKind}.mmpform   one form per provider
                                              when the package ships
                                              multiple sink kinds
       The Dashboard server reads the matching file back from the
       assembly the same way it reads CAPABILITY.yaml and ships the
       text on the capability response so MmpformRenderer can parse
       and render it. Sinks without any of these files continue on
       the v1 dashboard_config: path with no change. -->
  <ItemGroup>
    <EmbeddedResource Include="configuration*.mmpform">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ALSO pack each configuration*.mmpform as a side-file at the
       nupkg root so consumers and nuget.org file browsers can read
       the form schema without extracting the dll's embedded
       resource. The same file participates in EmbeddedResource
       (embed in assembly, for runtime Dashboard rendering) and
       None (pack as nupkg file, for offline inspection) — MSBuild
       allows item-type duality on the same physical path. -->
  <ItemGroup>
    <None Include="configuration*.mmpform"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

  <!-- Universal sink-auto-registration generator. Every Herald.Sinks.*
       csproj picks this up automatically through Directory.Build.props
       so a `dotnet add package Herald.Sinks.X` is the entire
       developer workflow — no fluent WithXSinkProviders() call, no
       manual RegisterAll(registry). The generator emits a
       [ModuleInitializer] in each sink assembly that registers every
       public concrete ILogSinkProvider with a publicly-constructable
       ctor into LogSinkProviderRegistry.Default at assembly load.

       Path is relative to this Directory.Build.props file:
         MSBuildThisFileDirectory = /e/dev/Herald/Modules/Herald.Sinks/
         + ..\..\..              = /e/dev/
         + Herald.OSS/generators/MMP.Herald.OSS.Generators.csproj
       OutputItemType=Analyzer makes Roslyn load it as a generator;
       ReferenceOutputAssembly=false keeps the netstandard2.0
       generator dll out of the sink's runtime closure. The generator
       lives in Herald.OSS so the entire sink ecosystem references a
       single upstream artifact. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Herald.OSS\generators\MMP.Herald.OSS.Generators.csproj')">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\Herald.OSS\generators\MMP.Herald.OSS.Generators.csproj">
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!--
    Herald.OSS dependency — every sink references the Herald.OSS
    library. Two resolution paths, picked automatically based on
    whether the Herald.OSS repo is cloned as a sibling of the
    Herald monorepo:

      * Sibling clone — /e/dev/Herald.OSS/Herald.OSS.csproj exists
                        relative to this monorepo at ../../../Herald.OSS/.
                        ProjectReference pulls the live source so a
                        Herald.OSS edit shows up immediately in every
                        sink build. Private="false" + ExcludeAssets="runtime"
                        keep Herald.OSS out of the sink plugin's bin\,
                        because Herald.Server / the host already loads
                        Herald.OSS and the plugin context resolves to
                        that copy via AssemblyDependencyResolver.
      * Standalone    — Herald.OSS is not present as a sibling (e.g. a
                        fresh `git clone https://github.com/mmpworks/Herald.Sinks`
                        outside the umbrella). PackageReference to
                        Herald.OSS on nuget.org pinned at the
                        HeraldCoreVersion declared above.

    The former route through Modules/Core is retired — Herald.OSS is
    the canonical upstream for the entire sink ecosystem.

    Per-sink csprojs do NOT declare a Herald.OSS reference of their
    own — the right one comes from here. A sink that needs to override
    (e.g. a private-fork experiment pinning a custom branch) sets
    <HeraldSinkCustomCoreRef>true</HeraldSinkCustomCoreRef> in its
    csproj and supplies its own reference; both ItemGroups below
    short-circuit on that flag.
  -->
  <!-- Sink-package branch: Private=false + ExcludeAssets=runtime is the
       plugin-packaging shape. The sink's .nupkg stays small, and at runtime
       Herald.Server / the host has Herald.OSS loaded — the plugin's
       AssemblyLoadContext resolves Herald.OSS to the host's copy. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Herald.OSS\Herald.OSS.csproj') AND '$(HeraldSinkCustomCoreRef)' != 'true' AND '$(IsTestProject)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\Herald.OSS\Herald.OSS.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Test-project branch: standard reference. Herald.OSS.dll flows into
       the test bin\ so xunit can load the assembly and discover tests.
       There is no plugin host loading Herald.OSS for us in a test process. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\Herald.OSS\Herald.OSS.csproj') AND '$(HeraldSinkCustomCoreRef)' != 'true' AND '$(IsTestProject)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\Herald.OSS\Herald.OSS.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\..\..\Herald.OSS\Herald.OSS.csproj') AND '$(HeraldSinkCustomCoreRef)' != 'true'">
    <!--
      Standalone PackageReference: NO PrivateAssets / ExcludeAssets.
      A consumer doing `dotnet add package Herald.Sinks.Datadog` to a
      plain ASP.NET Core or worker app expects Herald.OSS.dll to flow
      into their bin\ alongside the sink — otherwise the first sink
      registration throws FileNotFoundException at runtime. The
      sibling-clone branch above sets Private="false" + ExcludeAssets="runtime"
      because plugins live inside an AssemblyLoadContext where the host
      already loaded Herald.OSS; that's a plugin-packaging optimisation,
      not a NuGet-distribution policy.
    -->
    <PackageReference Include="Herald.OSS" />
  </ItemGroup>
</Project>
